# ransomware-recovery-lab configuration template.
# `make setup` copies this to .env and replaces every "change-me" with a random
# local-only credential. Never commit .env.

# Safety switch: the attack simulation refuses to run unless this is "true".
LAB_MODE=true

# Production database (docker compose service "postgres")
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=shop
PG_PASSWORD=change-me
PG_DB=shopdb

# Clean-room restore database (service "postgres_restore", same host)
RESTORE_PG_PORT=5433
RESTORE_PG_DB=shopdb_restored

# Backup vault: S3-compatible, Object Lock enabled (service "vault")
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=lab-backups

# Identity that may only write/read backups
WRITER_ACCESS_KEY=change-me
WRITER_SECRET_KEY=change-me

# Simulated stolen admin identity (used only by the attack and lockcheck)
ATTACKER_ACCESS_KEY=change-me
ATTACKER_SECRET_KEY=change-me

# Compliance-mode retention per backup object, and backup cadence
RETENTION_MINUTES=10
BACKUP_INTERVAL_SECONDS=60
